# Secrets and session artefacts — never commit
.probe-session.json
.probe-mqtt-events.json
.lan-creds.json
AnycubicSlicerNextControl/
*.log

# Operator-supplied cloud MQTT mutual-TLS identity — NEVER committed.
# The three files are extracted locally from the official Anycubic Slicer Next
# install (see resources/mqtt-tls/README.md). The folder itself stays in git so
# the relative path the code resolves is stable.
resources/mqtt-tls/*
!resources/mqtt-tls/README.md
# Safety net: no certificate or private-key bytes anywhere in the tree.
*.pem
*.key
*.crt
*.p12
*.pfx

# Capture artefacts (screenshots, event dumps) — reproducible, large
*.png
.sweep-events.json
.control-events.json
.bridge-routes.txt
.test-cube-15mm.stl

# POC captures — never commit account/device data (use docs/evidence for curated fixtures)
poc-output/

# Local experiments, UI automation, probes, and user-specific recovery scripts
local-scripts/

# Local CAD/render outputs
renders/

# Build output (regenerated by scripts/build.mjs from vendor/server.mjs)
dist/
node_modules/

# Blender scratch / external prerequisite artifacts — never commit
# (test fixtures under tests/fixtures/*.stl|*.3mf ARE committed — do not ignore those)
*.blend
*.blend1
*.gcode

# Quality tooling caches
.vitest/
.knip/