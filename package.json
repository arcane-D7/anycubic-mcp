{
  "name": "anycubic-slicer-next-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server for safe Anycubic Slicer Next automation on Windows.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint": "eslint .",
    "knip": "knip",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "sanitize": "node scripts/sanitize-repo.mjs --dry-run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test:unit && pnpm run build && pnpm run smoke && pnpm run check:licenses && pnpm run check:architecture && pnpm run sanitize"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "basic-ftp": "^6.2.0",
    "manifold-3d": "^3.5.3",
    "mqtt": "^5.15.2",
    "node-forge": "1.4.0",
    "pngjs": "^7.0.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "0.186.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@11.19.0"
}
